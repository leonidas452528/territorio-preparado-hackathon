# X-Robots-Tag: proyecto en desarrollo, no se indexa en buscadores; quitar al publicar en el dominio definitivo.
# Cabeceras para Netlify / Cloudflare Pages (GitHub Pages no las admite).
# CSP: three.js / Draco usan WebAssembly y workers de blob; los mosaicos del mapa vienen de OpenStreetMap.
# Fase 2: si la app usa Supabase, añadir su dominio a connect-src (https://<proyecto>.supabase.co).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.tile.opentopomap.org; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/ciudad/*
  Cache-Control: public, max-age=86400
/data/*
  Cache-Control: public, max-age=3600
